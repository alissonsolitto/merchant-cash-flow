# Auto-detect text files, ensure they use LF.
* text=auto eol=lf

# Bash scripts
*.sh  text eol=lf

# Windows-specific scripts keep CRLF for compatibility
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf

# Binary files - no line ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
