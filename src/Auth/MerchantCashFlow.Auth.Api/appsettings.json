{
  "ConnectionStrings": {
    "Auth": "Host=localhost;Port=5432;Database=auth;Username=cashflow;Password=cashflow"
  },
  "DataProtection": {
    "KeyRingPath": "keys"
  },
  "Database": {
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10
  },
  "Jwt": {
    "Issuer": "merchantcashflow-auth",
    "Audience": "merchantcashflow",
    "SigningKey": "",
    "ExpirationMinutes": 30
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/auth-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "outputTemplate": "{Timestamp:o} [{Level:u3}] {TraceId}/{SpanId} ({MachineName}/{ThreadId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
