{
  "Jwt": {
    "Issuer": "merchantcashflow-auth",
    "Audience": "merchantcashflow",
    "SigningKey": "",
    "ClockSkewSeconds": 30
  },
  "RateLimiting": {
    "Api": {      
      "PermitLimit": 1000,
      "QueueLimit": 200
    },
    "Auth": {
      "PermitLimit": 2,
      "WindowMinutes": 1
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-token": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/auth",
          "Methods": [ "POST" ]
        }
      },
      "ledger": {
        "ClusterId": "ledger",
        "AuthorizationPolicy": "ledger:write",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/ledger/{**catch-all}" }
      },
      "statement": {
        "ClusterId": "statement",
        "AuthorizationPolicy": "statement:read",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/api/statement/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "docker": { "Address": "http://auth-api:8080/" }
        },
        "HttpClient": { "PooledConnectionLifetime": "00:00:30" }
      },
      "ledger": {
        "Destinations": {
          "docker": { "Address": "http://ledger-api:8080/" }
        },
        "HttpClient": { "PooledConnectionLifetime": "00:00:30" }
      },
      "statement": {
        "Destinations": {
          "docker": { "Address": "http://statement-api:8080/" }
        },
        "HttpClient": { "PooledConnectionLifetime": "00:00:30" }
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "outputTemplate": "{Timestamp:o} [{Level:u3}] {TraceId}/{SpanId} ({MachineName}/{ThreadId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
