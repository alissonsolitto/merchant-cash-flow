{
  "ConnectionStrings": {
    "Statement": "Host=localhost;Port=5432;Database=statement;Username=cashflow;Password=cashflow",
    "Broker": "amqp://cashflow:cashflow@localhost:5672/"
  },
  "Database": {
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10
  },
  "Messaging": {
    "RetryCount": 3,
    "RetryIntervalSeconds": 5
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "MassTransit": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/statement-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "outputTemplate": "{Timestamp:o} [{Level:u3}] {TraceId}/{SpanId} ({MachineName}/{ThreadId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
